# phoenixNAP OAuth2 client credentials
export PNAP_CLIENT_ID='replace-me'
export PNAP_CLIENT_SECRET='replace-me'

# Cloudflare scoped API token: Zone Read + DNS Write for digitaldovey.net
export CLOUDFLARE_API_TOKEN='replace-me'

# Kubeconfig with cluster-admin access to the existing RHACM hub
export RHACM_KUBECONFIG="$HOME/.kube/acm-sandbox5165"

# Red Hat pull secret file
export OPENSHIFT_PULL_SECRET_FILE="$HOME/.config/openshift/pull-secret"
